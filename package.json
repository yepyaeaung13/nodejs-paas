{
  "name": "nodejs-paas",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight, Docker-free PaaS for Node.js on small VPS servers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yepyaeaung13/nodejs-paas.git"
  },
  "bugs": {
    "url": "https://github.com/yepyaeaung13/nodejs-paas/issues"
  },
  "homepage": "https://github.com/yepyaeaung13/nodejs-paas#readme",
  "keywords": [
    "paas",
    "self-hosted",
    "nodejs",
    "systemd",
    "caddy",
    "deployment",
    "docker-free"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
