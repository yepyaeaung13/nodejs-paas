# Server
PAAS_HOST=0.0.0.0
PAAS_PORT=3000
PAAS_DATA_DIR=./.data
PAAS_PUBLIC_URL=http://localhost:3000
PAAS_TRUST_PROXY=127.0.0.1

# Git deploys (the Linux installer writes these for you)
PAAS_SSH_USER=paas
PAAS_SSH_HOST=your-server.example.com
PAAS_INTERNAL_TOKEN_FILE=./.data/internal.token

# Caddy. Leave blank to skip Caddy integration in local development.
PAAS_CADDY_CONFIG=
PAAS_CADDY_SERVICE=caddy
PAAS_DASHBOARD_DOMAIN=

# GitHub App deployments (optional). Create the app in GitHub settings,
# install it on the wanted repositories, and point its webhook at
# <PAAS_PUBLIC_URL>/api/github/webhook.
# PAAS_GITHUB_APP_ID=123456
# PAAS_GITHUB_APP_SLUG=my-nodepaas
# PAAS_GITHUB_PRIVATE_KEY_FILE=/etc/paas/github-app.pem
# PAAS_GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
# PAAS_GITHUB_API_URL=https://api.github.com
# PAAS_GITHUB_WEB_URL=https://github.com

# Force mock mode (no systemd/useradd/caddy/npm execution).
# Automatically enabled on non-Linux platforms.
# PAAS_MOCK=1

# Optional bootstrap admin. The normal flow is the first-run setup screen.
# PAAS_ADMIN_USER=admin
# PAAS_ADMIN_PASSWORD=change-me
